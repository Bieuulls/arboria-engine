+				PackedColorArray([p_clear_color_val]),
+				1.0,
+				0
+			)
+			rd.draw_list_end()
+		return
+
+	# 3. Dispatch Compute Culling 100% na GPU
+	dispatch_culling(
+		camera,
+		Vector2(vp_size),
+		max_screen_error,
+		lod_mode,
+		forced_lod,
+		enable_frustum,
