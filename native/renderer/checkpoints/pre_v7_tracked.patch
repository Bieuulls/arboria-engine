+void main() {
+    uint mode = ubo.render_params.x;
+    vec3 n = normalize(v_normal);
+
+    if (mode == 0u) {
+        // Modo 0: Unshaded neutro - para isolar silhueta, cobertura e fendas entre clusters
+        out_color = vec4(0.8, 0.82, 0.85, 1.0);
+    } else if (mode == 1u) {
