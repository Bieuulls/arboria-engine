+func _recreate_viewport_framebuffer(tex_rd: RID, size: Vector2i) -> void:
+	if vp_framebuffer.is_valid():
+		rd.free_rid(vp_framebuffer)
+		vp_framebuffer = RID()
+	if vp_depth_tex.is_valid():
+		rd.free_rid(vp_depth_tex)
