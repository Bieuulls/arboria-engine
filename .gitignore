# Godot 4 specific ignores
.godot/
*.translation
*.uid
*.import
extension_api.json

# C++ & CMake build artifacts
build/
bin/
*.obj
!assets/*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.sqlite3

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Archives & Temporary files
*.rar
*.zip
*.7z
*.tar
*.gz
*.tmp
*.log

# Large generated procedural meshes (not versioned, re-generated by baker)
tests/procedural_1m.*
assets/procedural_1m.*

# Godot runtime asset copies (generated by build.bat from assets/ canonical source)
project/assets/

# Local artifacts, benchmarks & build directories
artifacts/
native/renderer/build/
baker/build/
tools/baker/build/
~*
.vscode/

# Test panel generated reports
tests/panel/reports/*.json
tests/panel/reports/*.md
tests/panel/reports/*.png
!tests/panel/reports/.gitkeep

project/diag_*.png
bench/results/captures/*.png


