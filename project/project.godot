config_version=5

[application]

config/name="ARBORIA ENGINE — Virtual Geometry Viewer"
config/description="Visualizador de Geometria Virtualizada (Cluster LOD) para Godot Engine"
run/main_scene="res://scenes/arboria_massive_world_demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=10
jolt_physics_3d/simulation/position_steps=2
jolt_physics_3d/simulation/allow_sleep=true
jolt_physics_3d/sleep/linear_threshold=0.1
jolt_physics_3d/sleep/angular_threshold=0.1
jolt_physics_3d/sleep/time_threshold=0.4
jolt_physics_3d/continuous_collision_detection/use_shape_cast=true
